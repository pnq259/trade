//--- Định nghĩa trạng thái Depth Qualification rõ ràng
enum ENUM_QUALIFICATION
  {
   QUAL_NOT_EVALUATED,
   QUALIFIED,
   QUAL_REJECTED
  };

//--- Định nghĩa trạng thái Candidate quản lý Recovery Mode chuẩn xác
enum ENUM_CANDIDATE_MODE
  {
   CANDIDATE_ACTIVE,
   CANDIDATE_RECOVERY
  };

//--- Phân loại kết quả Commit chi tiết
enum ENUM_COMMIT_RESULT
  {
   COMMIT_SUCCESS,
   COMMIT_RETRY,
   COMMIT_REJECTED,
   COMMIT_FATAL_ERROR
  };

//--- Phân loại kết quả Transfer/Reconstruct chi tiết
enum ENUM_TRANSFER_RESULT
  {
   TRANSFER_SUCCESS,
   TRANSFER_RETRY,
   TRANSFER_REJECTED,     
   TRANSFER_FATAL_ERROR
  };

//--- Phân loại kết quả Push Database chi tiết
enum ENUM_DB_RESULT
  {
   DB_SUCCESS,
   DB_RETRY,
   DB_REJECTED,
   DB_FATAL_ERROR
  };

//--- Định nghĩa cấu trúc chuẩn dữ liệu DTA 1.0 mở rộng
struct PivotPoint
  {
   int      bar_index;
   datetime time;
   double   price;
   int      type;              // 1 = Peak, -1 = Trough
   datetime condition_confirmation_time;
   int      condition_confirmation_bar;
   datetime sequence_confirmation_time;
   int      sequence_confirmation_bar;
   datetime confirmation_time; 
   int      confirmation_bar;  
   double   atr_at_cand;
   double   median_at_cand;
   double   k_at_cand;
   double   threshold_at_cand;
  };

//--- Cấu trúc Candidate Tracker mở rộng
struct CandidateTracker
  {
   int      bar_index;
   double   price;
   datetime time;
   double   atr;
   double   median;
   double   k;
   double   threshold;
   ENUM_QUALIFICATION depth_status;
   int      depth_confirm_bar;
   bool     is_atr_qualified;
   int      atr_confirm_bar;
   bool     has_valid_atr;
   ENUM_CANDIDATE_MODE mode;
   int      recovery_start_bar;
  };

enum ENUM_DTA_STATE { STATE_BOOTSTRAP, STATE_SEEKING_PEAK, STATE_SEEKING_TROUGH };

double         ZigZagHighBuffer[];
double         ZigZagLowBuffer[];

//--- DATABASE LAYER: Hệ thống mảng lưu trữ Chronological Sequence
PivotPoint     all_pivots[];       
PivotPoint     tracked_peaks[];    
PivotPoint     tracked_troughs[];  

int            AtrHandle = INVALID_HANDLE;
double         AtrBuffer[];
datetime       last_rates_time = 0; 
int            last_rates_total = 0;

int            last_logged_start = 0;
int            last_logged_end = 0;
string         last_logged_status = "";
string         last_logged_pivot_sign = ""; 

